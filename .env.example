# Copie para .env e ajuste. Nenhum segredo real deve ir para o git.
# Em producao, defina estas variaveis no host (nao use .env no servidor se puder evitar).

PORT=3000
NODE_ENV=development

# Obrigatorio em producao, minimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Banco. Com DATABASE_URL: Postgres real (obrigatorio em producao).
# Sem DATABASE_URL: PGlite local em PGLITE_DIR (so dev).
DATABASE_URL=
PGLITE_DIR=./data/pglite
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true
# Usado pelo docker-compose para criar o Postgres.
POSTGRES_PASSWORD=

# Atras de Nginx/Cloudflare/load balancer: numero de proxies na frente (ex.: 1).
TRUST_PROXY=

# Pagamento: 'mock' em desenvolvimento. 'sigilopay' com as chaves reais.
PAYMENTS_PROVIDER=mock
# Segredo HMAC do mock (obrigatorio em producao, min. 32). A SigiloPay nao usa este valor:
# ela devolve um token proprio ao criar cada PIX.
PAYMENTS_WEBHOOK_SECRET=
# SigiloPay. Chaves em Integrações > API no painel. A secreta so aparece uma vez.
SIGILOPAY_PUBLIC_KEY=
SIGILOPAY_SECRET_KEY=
# URL https do site, sem barra no fim. O webhook fica em {PUBLIC_BASE_URL}/api/webhooks/payments
# e tem que ser sempre essa mesma URL (a SigiloPay limita a 20 webhooks por integracao).
PUBLIC_BASE_URL=
# So no mock: 'false' deixa o deposito pendente para testar o fluxo de webhook.
PAYMENTS_MOCK_AUTOCONFIRM=true

# Bonus de cadastro em centavos (0 = sem bonus).
SIGNUP_BONUS_CENTS=0

# Minutos ate um round aberto ser encerrado automaticamente (recolhe se tiver corte).
ROUND_TTL_MIN=30

# Chave para cifrar dados sensiveis (CPF de saque em analise). Obrigatoria em producao, min. 32 caracteres.
DATA_KEY=
# Saques ate este valor (centavos) vao direto ao PSP; acima, aguardam aprovacao no admin. 0 = todos.
WITHDRAW_AUTO_MAX_CENTS=0

# Admins: nao ha mais variavel. Depois de criar a conta no site, rode no servidor:
#   npm run admin -- conceder 11999999999
# No 1o acesso ao /admin.html o painel pede para ativar o 2FA (app autenticador).

# Senha de acesso para ambiente de demonstracao exposto (vazia = site aberto)
DEMO_ACCESS_USER=equipe
DEMO_ACCESS_PASSWORD=
